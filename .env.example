# Copy to .env and fill in. .env is gitignored — never commit real values.
# All values have sane defaults; only touch what you need to change.

############################  Connectivity / ports  ############################
RAG_MCP_PORT=8084                  # MCP endpoint: http://localhost:8084/mcp
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=rag_kb

# Optional auth for Qdrant itself (set the SAME value on qdrant + both services).
# Leave blank to run Qdrant open (fine on a dev machine / compose-internal net).
QDRANT_API_KEY=

############################  Embedding provider  #############################
# Ingest and query MUST use the SAME provider+model — changing either after you
# have ingested requires a full re-ingest:
#   docker compose run --rm rag-ingest --recreate
#
#   ollama  -> local, offline, no API key. Pull once: `ollama pull nomic-embed-text`
#   openai  -> ANY OpenAI-compatible /v1/embeddings endpoint (OpenAI, a LiteLLM
#              proxy, Azure via gateway, Together, TEI in OpenAI mode, ...)

# -------------- ollama provider (default) --------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=nomic-embed-text

# ------- openai-compatible provider (only when EMBEDDINGS_PROVIDER=openai) -------
# EMBEDDINGS_PROVIDER=openai
# EMBEDDINGS_BASE_URL=https://api.openai.com      # or http://litellm:4000, etc.
# EMBEDDINGS_API_KEY=sk-...
# EMBEDDINGS_MODEL=text-embedding-3-small

# Task prefixes are automatic: nomic -> search_query:/search_document:, symmetric
# models (OpenAI text-embedding-*) -> none. Set these ONLY to override for another
# asymmetric family the auto-detect misses (e5/bge use "query: "/"passage: "):
# EMBED_QUERY_PREFIX=
# EMBED_DOC_PREFIX=

############################  Ingestion tuning  ################################
# Chunking + write batching (ingest.py). Batching bounds each HTTP request so one
# big document (e.g. a 100-page PDF) isn't a single multi-megabyte call.
# CHUNK_SIZE=1500
# CHUNK_OVERLAP=100
# EMBED_BATCH_SIZE=32               # chunks per embeddings request (no-op on Ollama)
# QDRANT_UPSERT_BATCH=64            # points per Qdrant upsert request

############################  Retrieval quality  ################################
# Hybrid search (recall): dense embeddings + local BM25 sparse vectors, fused
# with Reciprocal Rank Fusion. BM25 recovers exact tokens dense vectors miss
# (error strings, resource ids, component names). Runs offline via FastEmbed,
# no key. ON by default. CHANGING THIS requires a re-ingest — the collection
# schema differs (named vectors).
#   docker compose run --rm rag-ingest --recreate
RAG_HYBRID=true
# RAG_SPARSE_MODEL=Qdrant/bm25      # FastEmbed sparse model (default BM25)

# Cross-encoder reranking (precision): reorders top candidates so the best chunk
# lands in the top few. OFF by default. Query-time only — NO re-ingest needed.
# Best-effort: if it fails, search falls back to the fused order. Provider is a
# Cohere/Jina-compatible /rerank endpoint.
#   RERANK_PROVIDER=cohere            # none (default) | cohere
#   RERANK_MODEL=rerank-english-v3.0  # Cohere; or a Jina reranker model
#   RERANK_BASE_URL=https://api.cohere.com   # or https://api.jina.ai/v1
#   RERANK_API_KEY=
#   RERANK_CANDIDATES=30              # dense hits fetched before reranking
RERANK_PROVIDER=none

############################  Search limits / internal API  ####################
# RAG_DEFAULT_LIMIT=5               # default `limit` for rag_search
# RAG_MAX_LIMIT=20                  # hard cap for `limit`
# Shared token gating the internal /internal/knowledge/* write API (incident
# capture + feedback). NOT an MCP tool — invisible to the LLM either way.
# Blank = open (dev). Set it before exposing the port beyond localhost.
RAG_INTERNAL_TOKEN=
